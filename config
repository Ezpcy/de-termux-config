# i3 on Termux:X11 — a port of ~/.config/hypr (Hyprland) to X11.
# Same keybinds where X11/Android allows, same look: black background,
# 1px teal border, no gaps, no animations, blur only behind the launcher.
#
# Palette (main-theme, see hyprlock.conf):
#   bg #000000  bg_weak #0f0f0f  card #202124  primary_hi #155852
#   accent #29a99e  border #238f86  text #ebedf0  muted #8b8e94
#   danger #f7768e  warn #e0af68

# i3 doesn't expand variables inside other `set` values, so every path is
# written out in full.
set $mod Mod4
set $cfg ~/.config/i3
set $scripts ~/.config/i3/scripts

# kitty like on Hyprland; falls back to xfce4-terminal when kitty can't
# start (see scripts/term.sh)
set $term ~/.config/i3/scripts/term.sh
set $browser firefox
set $fileManager ~/.config/i3/scripts/term.sh -e yazi
set $launcher rofi -config ~/.config/i3/rofi/config.rasi -show drun

#######################
#### LOOK AND FEEL ####
#######################

font pango:NotoSans Nerd Font 10

# general:border_size = 1, gaps 0
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders none
gaps inner 0
gaps outer 0

# Tabbed/stacked title bars play the part of Hyprland's groupbar
title_align center
for_window [all] title_window_icon off

# class                 border  bg      text    indicator child_border
client.focused          #238f86 #155852 #ebedf0 #29a99e   #238f86
client.focused_inactive #000000 #202124 #8b8e94 #000000   #000000
client.unfocused        #000000 #202124 #8b8e94 #000000   #000000
client.urgent           #f7768e #f7768e #000000 #f7768e   #f7768e
client.placeholder      #000000 #0f0f0f #8b8e94 #000000   #000000
client.background       #000000

# misc
focus_follows_mouse yes
mouse_warping none
focus_on_window_activation smart
workspace_auto_back_and_forth no
floating_modifier $mod
tiling_drag modifier titlebar
floating_minimum_size 80 x 60

###################
#### AUTOSTART ####
###################

exec --no-startup-id setxkbmap ch
exec --no-startup-id xsetroot -solid "#000000" -cursor_name left_ptr
exec --no-startup-id $scripts/picom.sh
exec --no-startup-id dunst -config $cfg/dunst/dunstrc
exec_always --no-startup-id $cfg/polybar/launch.sh

#####################
#### WINDOWRULES ####
#####################

for_window [window_role="pop-up"]       floating enable
for_window [window_role="dialog"]       floating enable
for_window [window_type="dialog"]       floating enable
for_window [window_type="utility"]      floating enable
for_window [class="(?i)pavucontrol"]    floating enable, resize set 800 600, move position center
for_window [class="(?i)htop"]           floating enable, resize set 1100 700, move position center
for_window [title="(?i)^satty$"]        floating enable

#####################
#### KEYBINDINGS ####
#####################

# Launcher: tap Super, like `vicinae toggle` on release
bindcode --release 133 exec --no-startup-id $launcher
bindsym $mod+r exec --no-startup-id $launcher

# App launchers
bindsym $mod+b exec --no-startup-id $browser
bindsym $mod+Shift+b exec --no-startup-id $browser --new-window about:blank
bindsym $mod+Shift+t exec --no-startup-id $term
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+e exec --no-startup-id $fileManager
# btop refuses to run on Termux without root, htop works
bindsym $mod+Control+Escape exec --no-startup-id $term --class htop -e htop

# Screenshots (maim + xclip instead of grim/slurp/wl-copy)
bindsym $mod+Shift+s exec --no-startup-id $scripts/screenshot.sh region
bindsym $mod+Print exec --no-startup-id $scripts/screenshot.sh window
bindsym $mod+Shift+Print exec --no-startup-id $scripts/screenshot.sh screen

# Window management
bindsym $mod+q kill
bindsym $mod+f floating toggle
bindsym $mod+m fullscreen toggle
# hyprctl kill: click a window to kill its client
bindsym $mod+d exec --no-startup-id xdotool selectwindow windowkill
# togglesplit: the next window opens beside / below
bindsym $mod+s split toggle
# Super+A cycles the focused container's layout, with a toast
bindsym $mod+a exec --no-startup-id $scripts/layout.sh
# Toggle the bar (pkill -USR1 waybar)
bindsym $mod+space exec --no-startup-id polybar-msg cmd toggle

# Move focus with mainMod + hjkl
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move window with mainMod + SHIFT + hjkl
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# "Swap" with mainMod + CONTROL + SHIFT + hjkl (i3 can't swap by direction,
# moving gives the same result for two neighbours)
bindsym $mod+Control+Shift+h move left
bindsym $mod+Control+Shift+j move down
bindsym $mod+Control+Shift+k move up
bindsym $mod+Control+Shift+l move right

# Resize window with mainMod + CONTROL + hjkl (40px, like the Hypr binds)
bindsym $mod+Control+h resize shrink width 40 px or 4 ppt
bindsym $mod+Control+l resize grow width 40 px or 4 ppt
bindsym $mod+Control+k resize shrink height 40 px or 4 ppt
bindsym $mod+Control+j resize grow height 40 px or 4 ppt

# Workspaces: mainMod + [0-9] switch,
# + SHIFT move silently, + CONTROL + SHIFT move and follow
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+Control+Shift+1 move container to workspace number 1, workspace number 1
bindsym $mod+Control+Shift+2 move container to workspace number 2, workspace number 2
bindsym $mod+Control+Shift+3 move container to workspace number 3, workspace number 3
bindsym $mod+Control+Shift+4 move container to workspace number 4, workspace number 4
bindsym $mod+Control+Shift+5 move container to workspace number 5, workspace number 5
bindsym $mod+Control+Shift+6 move container to workspace number 6, workspace number 6
bindsym $mod+Control+Shift+7 move container to workspace number 7, workspace number 7
bindsym $mod+Control+Shift+8 move container to workspace number 8, workspace number 8
bindsym $mod+Control+Shift+9 move container to workspace number 9, workspace number 9
bindsym $mod+Control+Shift+0 move container to workspace number 10, workspace number 10

# Cycle windows (cycle_next)
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev

# Groups / stacks -> i3 tabbed containers
bindsym $mod+t layout toggle tabbed split
bindsym $mod+Control+Right focus next sibling
bindsym $mod+Control+Left focus prev sibling
# Moving a window out of a tabbed container: Super+Shift+hjkl

# Special workspace "magic" -> i3 scratchpad
bindsym $mod+x scratchpad show
bindsym $mod+Shift+x move scratchpad
bindsym $mod+Control+Shift+x move scratchpad, scratchpad show

# Scroll through workspaces with mainMod + scroll
bindsym --whole-window $mod+button5 workspace next_on_output
bindsym --whole-window $mod+button4 workspace prev_on_output

# Volume keys (wpctl -> pactl)
bindsym XF86AudioRaiseVolume exec --no-startup-id $scripts/volume.sh raise
bindsym XF86AudioLowerVolume exec --no-startup-id $scripts/volume.sh lower
bindsym XF86AudioMute exec --no-startup-id $scripts/volume.sh mute
bindsym XF86AudioMicMute exec --no-startup-id $scripts/volume.sh micmute

# Session
bindsym $mod+Shift+r restart
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec --no-startup-id $scripts/stop-desktop.sh
